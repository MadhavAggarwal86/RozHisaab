PORT=5050
MONGO_URI=
JWT_SECRET=
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173
# Shared AI key used by every shop: Groq (gsk_…) or xAI (xai-…)
AI_API_KEY=
# Optional rate limits (defaults shown). Window values are in milliseconds.
# LOGIN_RATE_LIMIT=5
# LOGIN_RATE_WINDOW_MS=900000
# PRODUCT_CREATE_RATE_LIMIT=20
# PRODUCT_CREATE_RATE_WINDOW_MS=60000
# BILL_CREATE_RATE_LIMIT=30
# BILL_CREATE_RATE_WINDOW_MS=60000
# Proxy hops to trust for client IPs. Defaults to 1 on Render, off elsewhere.
# TRUST_PROXY=1
